{
  "name": "aall",
  "version": "0.1.3",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "check": "vp check && pnpm check:kotlin",
    "check:kotlin": "bash scripts/ktlint.sh",
    "format": "vp check --fix && bash scripts/ktlint.sh --format",
    "build:apk": "bash scripts/build-apk.sh",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-modules-core": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "tailwindcss": "4.1.18",
    "uniwind": "1.13.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vite-plus": "1.5.0"
  },
  "packageManager": "pnpm@12.16.1"
}
